@using BookStoreApp.Domain.Models

@model IEnumerable<Book>

@if (Model == null || !Model.Any())
{
    <p>No books available.</p>
    return;
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsBorrowed)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateTimeBorrowed)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsBorrowed)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DateTimeBorrowed)
                </td>
            </tr>
        }
    </tbody>
</table>
